// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

// =====================================================================
// COMPANIES (Empresas / Tenants)
// =====================================================================
model Company {
  id                         Int       @id @default(autoincrement())
  name                       String    @db.Text
  companyCode                String    @unique @db.Text
  contactEmail               String?   @db.Text
  phone                      String?   @db.Text
  whatsappPhoneNumberId      String?   @unique @db.Text
  whatsappAccessToken        String?   @db.Text
  whatsappDisplayNumber      String?   @db.Text
  isActive                   Boolean   @default(true)
  createdAt                  DateTime  @default(now())
  updatedAt                  DateTime  @updatedAt

  // Relations
  users                      User[]
  appointments               Appointment[]
  plannings                  Planning[]
  sessionActions             SessionAction[]

  @@map("companies")
}

// =====================================================================
// USERS (Usuarios / Profesionales)
// =====================================================================
model User {
  id                    Int       @id @default(autoincrement())
  companyId             Int?
  company               Company?  @relation(fields: [companyId], references: [id])
  username              String?   @unique @db.Text
  email                 String    @unique @db.Text
  password              String    @db.Text
  name                  String?   @db.Text
  phone                 String?   @db.Text
  type                  String?   @default("staff") @db.Text  // "peluquero", "fisio", etc.
  specialties           String?   @db.Text                     // comma-separated
  role                  String?   @default("user") @db.Text   // "admin", "user", etc.
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Relations
  appointments          Appointment[]
  plannings             Planning[]

  @@map("users")
}

// =====================================================================
// APPOINTMENTS (Citas)
// =====================================================================
model Appointment {
  id                    Int       @id @default(autoincrement())
  companyId             Int?
  company               Company?  @relation(fields: [companyId], references: [id])
  phone                 String    @db.Text
  customerName          String?   @db.Text
  datetime              DateTime
  userId                Int?
  user                  User?     @relation(fields: [userId], references: [id])
  duration              Int       @default(60)
  service               String    @default("physio") @db.Text
  status                String    @default("confirmed") @db.Text  // "confirmed", "cancelled", etc.
  notes                 String?   @db.Text
  customId              String?   @unique @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // Índice para prevenir doble-booking
  @@unique([userId, datetime], name: "unique_user_datetime_active")
  @@index([phone])
  @@index([customId])
  @@index([status])
  @@map("appointments")
}

// =====================================================================
// PLANNING (Planificación de usuarios)
// =====================================================================
model Planning {
  id                    Int       @id @default(autoincrement())
  companyId             Int?
  company               Company?  @relation(fields: [companyId], references: [id])
  userId                Int
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  DateTime  @db.Date
  type                  String    @db.Text  // "work", "vacation", "sick"
  startTime             String?   @db.Text  // "HH:MM" format
  endTime               String?   @db.Text  // "HH:MM" format
  notes                 String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@unique([userId, date], name: "unique_user_date")
  @@index([date])
  @@map("planning")
}

// =====================================================================
// SESSION_ACTIONS (Registro de acciones / Auditoría)
// =====================================================================
model SessionAction {
  id                    Int       @id @default(autoincrement())
  phone                 String    @db.Text
  companyId             Int?
  company               Company?  @relation(fields: [companyId], references: [id])
  action                String    @db.Text  // "booking", "cancel", "go_back", "restart", etc.
  step                  String?   @db.Text  // current step when action occurred
  sessionData           Json?                // JSONB data
  errorMessage          String?   @db.Text
  success               Boolean   @default(true)
  createdAt             DateTime  @default(now())

  @@index([phone, createdAt], name: "idx_phone_created")
  @@index([success])
  @@map("session_actions")
}

